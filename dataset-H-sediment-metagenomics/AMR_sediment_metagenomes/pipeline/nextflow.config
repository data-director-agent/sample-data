// nextflow config - TA. works on the cluster, not tested anywhere else
params {
    reads      = '/home/tashworth/scratch/holme_amr/raw/*_R{1,2}.fastq.gz'
    outdir     = '/home/tashworth/scratch/holme_amr/results'
    kraken_db  = '/home/tashworth/dbs/k2_standard'
    card_db    = '/home/tashworth/dbs/card'   // downloaded "some time in 2025"
    host_removal = false   // TODO decide
}

process {
    executor = 'slurm'
    queue    = 'general'
    withName: FASTP   { container = 'quay.io/biocontainers/fastp:latest' }
    withName: KRAKEN2 { container = 'quay.io/biocontainers/kraken2:latest' }
    withName: RGI     { container = 'quay.io/biocontainers/rgi:latest' }
    withName: MULTIQC { container = 'multiqc/multiqc:latest' }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/home/tashworth/.singularity'
}
